# ============================================================================
# AUTONOMA AI — szablon zmiennych środowiskowych
# Skopiuj jako ".env" (plik .env jest w .gitignore). Wpisuj TYLKO u siebie.
# Bez żadnego klucza system działa w trybie dry-run: treści trafiają do queue/,
# AI używa szablonów, baza = lokalny SQLite, nic nie jest wysyłane na zewnątrz.
# Każda publikacja wymaga akceptacji człowieka (kolejka akceptacji).
# ============================================================================

# ===== Tryb pracy =====
# 1 = nic nie wysyłaj; 0 = live tam, gdzie są klucze; puste = auto (dry-run gdy brak kluczy zapisu)
DRY_RUN=
# 1 = scouty używają sources/fixtures (bez sieci), np. w testach
OFFLINE=
# adres strony (sitemap, robots.txt, linki UTM)
SITE_URL=https://twoja-domena.pl
# fallback mailto w formularzu, link wypisu z newslettera
CONTACT_EMAIL=kontakt@twoja-domena.pl
# dowolny długi losowy ciąg; odblokowuje /api/ai-generate (Pages) i panel admina
ADMIN_TOKEN=

# ===== AI (darmowe plany) =====
# Google AI Studio free tier – generowanie treści przez LLM zamiast szablonów (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Groq free tier – zapasowy LLM (llama-3.3-70b) (https://console.groq.com/keys)
GROQ_API_KEY=
# Cloudflare free – Workers AI (ok. 10k neuronów/dzień)
CF_ACCOUNT_ID=
# Cloudflare API token z uprawnieniem Workers AI
CF_API_TOKEN=

# ===== Baza (Supabase Free; puste = lokalny SQLite db/local_storage.db) =====
# Supabase Free – zdalna baza (leady, treści, projekty)
SUPABASE_URL=
# service role – TYLKO lokalnie/GitHub Secrets (leads.py sync, engine); nigdy w Pages/public
SUPABASE_KEY=
# anon – w Cloudflare Pages env dla /api/lead (RLS: tylko INSERT do leads)
SUPABASE_ANON_KEY=
# (Pages env) tenant przypisany leadom ze strony
TENANT_ID=default
# opcjonalna ścieżka lokalnej bazy SQLite (domyślnie db/local_storage.db)
LOCAL_DB_PATH=

# ===== Powiadomienia / publikacja (tylko treści zatwierdzone przez człowieka) =====
# Telegram (darmowy, @BotFather) – powiadomienia o paczkach i nowych leadach
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Make/n8n/Discord webhook (plany free) – przekazanie zatwierdzonych treści
WEBHOOK_URL=
# LinkedIn API (wymaga aplikacji) – publikacja zatwierdzonego posta
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:<id>
LINKEDIN_AUTHOR_URN=

# ===== Newsletter (tylko subskrybenci ze zgodą) =====
# Brevo free (300 e-maili/dzień)
BREVO_API_KEY=
# Resend free (100 e-maili/dzień) – alternatywa
RESEND_API_KEY=
# zweryfikowany adres nadawcy; brak = newsletter w dry-run
NEWSLETTER_FROM=

# ===== Strona / SEO =====
# IndexNow (darmowe) – ping wyszukiwarek po publikacji; plik klucza w public/<key>.txt
INDEXNOW_KEY=
# true = zgoda właściciela na publikację na zewnętrznym CMS
CMS_OWNER_AUTHORIZED=false
CMS_PUBLISH_MODE=require_approval
# github_markdown | wordpress | webhook
CMS_TYPE=github_markdown
# owner/repo (GitHub free) dla github_markdown
CMS_GH_REPO=
# fine-grained PAT z contents:write tylko do tego repo
CMS_GH_TOKEN=
CMS_GH_PATH=public/articles
WP_SITE_URL=
WP_USERNAME=
# WordPress Application Password
WP_APP_PASSWORD=
CMS_WEBHOOK_URL=
CMS_API_KEY=
# adres local_server.py
LOCAL_BIND=127.0.0.1
